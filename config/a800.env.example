# Copy to config/local/a800.env and edit locally.
# Never commit the local file.

# Define this alias in ~/.ssh/config. Do NOT put a password here.
A800_SSH_ALIAS=a800-lab

# Remote project area. Keep experiments inside your authorized directory.
A800_REMOTE_WORKDIR=~/whr

# Recommended dedicated project environment.
A800_CONDA_ENV=auto_research

# Candidate availability thresholds. These only identify a candidate GPU;
# they do NOT authorize automatic use.
A800_MIN_FREE_MIB=60000
A800_MAX_UTIL_PCT=5
A800_POLL_SEC=60
